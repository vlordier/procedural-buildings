# @meta
# materials: plaster,roof_tile
# params: none
# complexity: medium
pitch = 0.65
wallR = 0.85
wallG = 0.75
wallB = 0.65
roofR = 0.40
roofG = 0.30
roofB = 0.25
trimR = 0.90
trimG = 0.85
trimB = 0.80
glassR = 0.60
glassG = 0.70
glassB = 0.80
plot --> S(~1, ~1, 12){townhouse}
townhouse --> split(z){~8 : colour(wallR, wallG, wallB){townhouseWalls} | ~4 : townhouseRoof}
townhouseWalls --> comp(f){front : townhouseFacade | left : I(rect) | right : I(rect) | back : I(rect)}
townhouseFacade --> split(z){~3 : split(x){~1 : I(rect) | ~2 : doorPanel | ~2 : windowUnit | ~1 : I(rect)} | ~3 : split(x){~1 : I(rect) | ~2 : windowDecor | ~1 : I(rect) | ~2 : windowDecor | ~1 : I(rect)} | ~2 : split(x){~1 : I(rect) | ~2 : windowDecor | ~1 : I(rect) | ~2 : windowDecor | ~1 : I(rect)}}
doorPanel --> colour(trimR, trimG, trimB){split(x){~0.15 : I(rect) | ~1.7 : colour(0.3, 0.25, 0.2){I(rect)} | ~0.15 : I(rect)}}
windowUnit --> colour(trimR, trimG, trimB){split(x){~0.15 : I(rect) | ~1.7 : colour(glassR, glassG, glassB){I(rect)} | ~0.15 : I(rect)}}
windowDecor --> colour(trimR, trimG, trimB){split(x){~0.15 : I(rect) | ~1.7 : split(x){~0.1 : trim | ~1.5 : colour(glassR, glassG, glassB){I(rect)} | ~0.1 : trim} | ~0.15 : I(rect)}}
trim --> colour(trimR, trimG, trimB){I(rect)}
townhouseRoof --> colour(roofR, roofG, roofB){S(width * 1.08, depth * 1.08, pitch * width * 1.08 / 2){T(-width * 0.04, -depth * 0.04, 0){I(triangle)}}}