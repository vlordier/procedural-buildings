# @meta
# materials: stone, glass, roof_tile
# params:
# complexity: medium
stationHeight = 6
roofHeight = 2.5
stoneR = 0.65
stoneG = 0.60
stoneB = 0.55
glassR = 0.60
glassG = 0.70
glassB = 0.80
roofR = 0.40
roofG = 0.25
roofB = 0.20
plot --> S(~1.5, ~1, stationHeight + roofHeight){station}
station --> split(z){~stationHeight : colour(stoneR, stoneG, stoneB){stationWalls} | ~roofHeight : colour(roofR, roofG, roofB){S(width * 1.1, depth * 1.1, roofHeight){T(-width * 0.05, -depth * 0.05, 0){I(triangle)}}}}
stationWalls --> comp(f){front : split(x){~1 : I(rect) | ~3 : colour(glassR, glassG, glassB){I(rect)} | ~1 : I(rect) | ~3 : colour(glassR, glassG, glassB){I(rect)} | ~1 : I(rect)} | left : I(rect) | right : I(rect) | back : I(rect)}
