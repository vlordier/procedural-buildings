# @meta
# materials: (gin-configured)
# params: wallPattern=0
# complexity: medium
wallPattern = 0
roofPattern = 0
wallR = 0.70
wallG = 0.70
wallB = 0.70
patR = 0.30
patG = 0.30
patB = 0.20
roofR = 0.50
roofG = 0.30
roofB = 0.20
stripeW = 0.15
tileS = 0.30
plot --> S(~1, ~1, 12){building}
building --> split(z){~8 : wallSection | ~4 : roofSection}
roofSection --> colour(roofR, roofG, roofB){S(width * 1.05, depth * 1.05, 2.5){T(-width * 0.025, -depth * 0.025, 0){I(triangle)}}}
wallSection : wallPattern == 0 --> colour(wallR, wallG, wallB){I(rect)}
wallSection : wallPattern == 1 --> repeat(z){stripeW + stripeW : split(z){~stripeW : colour(patR, patG, patB){I(rect)} | ~stripeW : colour(wallR, wallG, wallB){I(rect)}}}
wallSection : wallPattern == 2 --> repeat(x){stripeW + stripeW : split(x){~stripeW : colour(patR, patG, patB){I(rect)} | ~stripeW : colour(wallR, wallG, wallB){I(rect)}}}
wallSection : wallPattern == 3 --> repeat(x){tileS + tileS : split(x){~tileS : split(z){~tileS : colour(wallR, wallG, wallB){I(rect)} | ~tileS : colour(patR, patG, patB){I(rect)}} | ~tileS : split(z){~tileS : colour(patR, patG, patB){I(rect)} | ~tileS : colour(wallR, wallG, wallB){I(rect)}}}}
wallSection : wallPattern == 4 --> split(z){~1 : colour(wallR, wallG, wallB){I(rect)} | ~1 : colour(wallR + (patR - wallR)*0.25, wallG + (patG - wallG)*0.25, wallB + (patB - wallB)*0.25){I(rect)} | ~1 : colour(wallR + (patR - wallR)*0.5, wallG + (patG - wallG)*0.5, wallB + (patB - wallB)*0.5){I(rect)} | ~1 : colour(wallR + (patR - wallR)*0.75, wallG + (patG - wallG)*0.75, wallB + (patB - wallB)*0.75){I(rect)} | ~1 : colour(patR, patG, patB){I(rect)}}